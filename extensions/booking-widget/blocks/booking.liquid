{% comment %}
  Only renders on a product that has the "bookwell.service_id" metafield set
  (the merchant linked it to a service in the Bookwell admin), or when a
  service ID is entered in the block settings. Every other page loads none of
  this app's script or CSS.
{% endcomment %}

{% assign service_id = block.settings.service_id %}
{% if service_id == blank and product %}
  {% assign service_id = product.metafields.bookwell.service_id.value | default: product.metafields.bookwell.service_id %}
{% endif %}

{% if service_id != blank %}
  <div
    class="bookwell-widget"
    data-service-id="{{ service_id | escape }}"
    data-lang="{{ request.locale.iso_code }}"
    {% if block.settings.accent_color != blank %}data-accent="{{ block.settings.accent_color }}"{% endif %}
    {% if block.settings.open_by_default %}data-open="true"{% endif %}
    {{ block.shopify_attributes }}
  ></div>

  {{ 'booking.css' | asset_url | stylesheet_tag }}
  <script src="{{ 'booking.js' | asset_url }}" defer></script>
{% endif %}

{% schema %}
{
  "name": "Bookwell booking",
  "target": "section",
  "settings": [
    {
      "type": "text",
      "id": "service_id",
      "label": "Service ID (optional)",
      "info": "Leave empty on product pages: the product's linked service is used. Fill it in to show a specific service on any page."
    },
    {
      "type": "checkbox",
      "id": "open_by_default",
      "label": "Show the calendar straight away",
      "default": false
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent color override",
      "info": "Leave empty to use the colour from Bookwell → Settings → Calendar design."
    }
  ]
}
{% endschema %}
