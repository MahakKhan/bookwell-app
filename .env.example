# Copy to .env and fill in after running `shopify app config link`.
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SCOPES=read_products,write_products,read_orders,read_customers
SHOPIFY_APP_URL=

# Local dev default. Swap for a real Postgres URL before deploying.
DATABASE_URL="file:./dev.sqlite"

# Optional — only needed for the "Connect Google Calendar" button in
# Settings. See the README's "bring your own provider" section.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
