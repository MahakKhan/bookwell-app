# Copy to .env. `shopify app dev` injects SHOPIFY_API_SECRET and the tunnel
# URL (HOST) at runtime, so for local dev only DATABASE_URL, SCOPES and
# CRON_SECRET really need to be set.
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SCOPES=read_products,write_products,write_orders,write_draft_orders,write_app_proxy,read_themes
SHOPIFY_APP_URL=

# Postgres (the schema and migrations are Postgres-only; SQLite will not work).
# Use a SEPARATE database for local dev if production shares this one.
DATABASE_URL="postgresql://user:password@localhost:5432/bookwell"

# Optional: "Connect Google Calendar" (redirect URI: <app url>/oauth/google/callback).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional: "Connect Zoom" (redirect URL: <app url>/oauth/zoom/callback).
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=

# Optional: Outlook Calendar + Microsoft Teams (Azure app registration;
# redirect URI: <app url>/oauth/microsoft/callback).
MS_CLIENT_ID=
MS_CLIENT_SECRET=

# Optional: "Create your service with AI" and the AI phone receptionist (Claude API key).
ANTHROPIC_API_KEY=

# Required for pre-appointment reminders. Your scheduler calls
# POST /api/reminders/send with header "X-Cron-Secret: <this value>"
# (query-string secrets are no longer accepted).
CRON_SECRET=

# Optional: key used to encrypt stored Resend/Twilio/Google credentials.
# Defaults to a key derived from SHOPIFY_API_SECRET.
ENCRYPTION_KEY=

# Set to "true" in production to take REAL Shopify charges. Anything else
# (including unset) creates test charges only.
BILLING_LIVE=

# Shown on the public privacy / terms / support pages (and your App Store listing).
LEGAL_NAME=Bookwell
SUPPORT_EMAIL=
